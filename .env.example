# Scriptorium — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ── LLM Provider (use exactly one) ──────────────────────────────────────
# Google Gemini (recommended — free tier available)
GEMINI_API_KEY=your-gemini-api-key-here

# Model tiers — Scriptorium uses two roles:
#   PLANNER  → brief + outline generation (structured reasoning, called 2x per run)
#   EXECUTOR → drafting, scrubbing, fact-checking (throughput, called N× per section)
#
# Production (default)
GEMINI_PLANNER_MODEL=gemini-3.5-flash
GEMINI_EXECUTOR_MODEL=gemini-3.1-flash-lite
#
# Testing / lower cost (uncomment to override)
# GEMINI_PLANNER_MODEL=gemini-2.5-pro
# GEMINI_EXECUTOR_MODEL=gemini-2.5-flash

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# OpenAI planner: gpt-5.5 | executor: gpt-5.3

# Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Anthropic planner: claude-opus-4-5 | executor: claude-sonnet-4-5

# ── Server ───────────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8000

# ── Database paths (defaults work out-of-the-box) ────────────────────────
# SEMANTIC_DB_PATH=db/semantic.db
# COMPLIANCE_DB_PATH=db/compliance.db

# ── Artefacts ────────────────────────────────────────────────────────────
# ARTIFACTS_DIR=artifacts
